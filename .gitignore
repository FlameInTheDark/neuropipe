# Build output — never commit compiled binaries or artifacts
/build/bin/
/bin/
*.exe
*.dll
*.so
*.dylib

# Wails v3 generated syso files (regenerated by `wails3 generate syso`)
/rsrc_windows_*.syso
*.syso

# WebView2 bootstrapper (generated by `wails3 generate webview2bootstrapper`)
/build/windows/nsis/MicrosoftEdgeWebview2Setup.exe

# Frontend build output (regenerated by `bun run build` or served by Vite in dev)
/frontend/dist/
# Keep the placeholder so //go:embed doesn't fail on a fresh clone
!/frontend/dist/index.html

# Frontend dependencies and cache
/frontend/node_modules/
/frontend/.vite/

# Go build and test output
*.test
*.out
/coverage.out
/coverage.html

# Local workspace data (SQLite databases, logs, etc.)
/neuropipe.db
/neuropipe.db-*
/data/
*.log

# Environment files
/.env
/.env.*
!.env.example

# Editor and operating-system files
/.idea/
/.vscode/
.DS_Store
Thumbs.db

# Bun and Node cache
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
bun-debug.log*

# TypeScript build info (regenerated by tsc)
*.tsbuildinfo

# Wails v3 internal directories
/.wails/
/wails-build/